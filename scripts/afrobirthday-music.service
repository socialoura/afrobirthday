[Unit]
Description=AfroBirthday free music downloader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/lib/afrobirthday-music/venv/bin/python %h/projects/afrobirthday/scripts/music-worker.py
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=MUSIC_SECRET_ID=255dfcf9-b716-4bf4-b442-b4fa00dbd854
Environment=BWS_SERVER_URL=https://vault.bitwarden.eu
Environment=MUSIC_VAULT_ENV=%h/.hermes/profiles/afrobirthday/.env
Environment=MUSIC_SCRATCH_ROOT=%h/.hermes/profiles/afrobirthday/cache/scratch/musique-worker
Environment=TMPDIR=%h/.hermes/profiles/afrobirthday/cache/scratch/musique-worker
Restart=always
RestartSec=15
TimeoutStopSec=160
KillMode=control-group
UMask=0077
NoNewPrivileges=true
MemoryMax=768M
CPUQuota=60%

[Install]
WantedBy=default.target
