# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin auth (REQUIRED) ---
# ADMIN_TOKEN_SECRET must be a strong random string of at least 32 chars.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN_SECRET=replace-me-with-a-long-random-string-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PayPal ---
# PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# --- Discord notifications ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Database (Neon Postgres) ---
POSTGRES_URL=

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) ---
# RESEND_API_KEY=re_...
# RESEND_FROM=AfroBirthday <noreply@afrobirthday.com>

# --- Music Download (Optional) ---
# By default, uses free Cobalt API (https://co.wuk.sh)
# For more reliability, use Rapidapi (100 free requests/month):
#   https://rapidapi.com/ytjar/api/youtube-mp36
# RAPIDAPI_KEY=your_rapidapi_key_here

# Or self-host yt-dlp service and set custom API URL:
# MUSIC_DOWNLOAD_API_URL=https://your-ytdlp-service.com/api

# Disable auto-download (only send link to Discord):
# DISABLE_MUSIC_AUTO_DOWNLOAD=true
