# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored on purpose.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin auth (REQUIRED) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
# Strong random string, at least 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN_SECRET=

# --- Stripe (REQUIRED) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PayPal (REQUIRED) ---
# PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Database (Supabase Postgres, REQUIRED) ---
POSTGRES_URL=
DATABASE_URL=

# --- Storage (Supabase Storage, REQUIRED) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend, REQUIRED) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=AfroBirthday <support@afrobirthday.com>

# --- Discord notifications (optional, currently hard-disabled in code) ---
# DISCORD_WEBHOOK_URL=

# --- Telegram Bot (REQUIRED for order-fulfillment notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AWS Bedrock (optional — powers the Telegram bot's free-text AI assistant;
# without these, the bot's slash commands still work, only the AI Q&A doesn't) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Music Download (optional) ---
# By default, uses the free Cobalt API (https://co.wuk.sh — often unreliable).
# For more reliability, use RapidAPI (100 free requests/month):
#   https://rapidapi.com/ytjar/api/youtube-mp36
# RAPIDAPI_KEY=

# Or self-host yt-dlp and set a custom API URL:
# MUSIC_DOWNLOAD_API_URL=https://your-ytdlp-service.com/api

# Disable auto-download (only send the link to the fulfillment channel):
# DISABLE_MUSIC_AUTO_DOWNLOAD=true

# --- Voiceover (OpenAI TTS, REQUIRED — generates spoken audio for non-English
# birthday messages, attached for the person producing the video) ---
OPENAI_API_KEY=
# Optional: OPENAI_TTS_VOICE (alloy|echo|fable|onyx|nova|shimmer), OPENAI_TTS_MODEL.
OPENAI_TTS_VOICE=onyx

# --- Cron auth (REQUIRED in production — /api/cron/check-overdue is
# unauthenticated without it) ---
CRON_SECRET=

# --- WhatsApp (optional; the chat widget hides its WhatsApp button until
# this is set, rather than linking to a broken number) ---
# NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567

# --- PostHog (REQUIRED for analytics) ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Personal API Key (Settings -> Personal API Keys, read scope on Insights),
# used server-side only to power real visitor counts in the admin dashboard.
POSTHOG=
