    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "recharts": "^3.7.0",
    "stripe": "^16.2.0",
    "tailwind-merge": "^2.4.0",
    "web-vitals": "^5.3.0",
    "zod": "^3.23.8"
